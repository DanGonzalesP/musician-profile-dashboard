{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vibe-staging-media-maintenance",
  "main": "workers/media-maintenance.ts",
  "compatibility_date": "2026-11-05",
  "account_id": "5b647e532f3d4996206529d5595295f3",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  // Añadir cron sólo tras comprobar recuperación y aislamiento en staging.
  "triggers": { "crons": [] },
  "r2_buckets": [{ "binding": "VIBE_MEDIA", "bucket_name": "vibe-staging-artist-media" }],
  "vars": {
    "ENABLE_MEDIA_MAINTENANCE": "false",
    "SUPABASE_URL": "https://iyppeurjtbuydhjtraxf.supabase.co"
  }
}
