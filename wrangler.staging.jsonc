{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Recursos R2/D1 creados en la cuenta empresarial el 2026-11-06.
  // Supabase staging preparado; sin Worker desplegado ni origen público configurado.
  "name": "vibe-staging",
  "account_id": "5b647e532f3d4996206529d5595295f3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No añadir ruta pública hasta definir acceso y origen de staging.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vibe-staging" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/ffmpeg/ffmpeg-core.wasm"]
  },
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vibe-staging-cache-incremental" },
    { "binding": "VIBE_STATIC_ASSETS", "bucket_name": "vibe-staging-static-assets" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "d1_databases": [{
    "binding": "NEXT_TAG_CACHE_D1",
    "database_name": "vibe-staging-cache-etiquetas",
    "database_id": "37f4a26b-5d19-4143-a632-c52a2aba7dd5"
  }],
  "vars": {
    "TRUSTED_PROXY": "true",
    "NEXT_PUBLIC_SUPABASE_URL": "https://iyppeurjtbuydhjtraxf.supabase.co",
    "R2_ACCOUNT_ID": "5b647e532f3d4996206529d5595295f3",
    "R2_ENDPOINT": "https://5b647e532f3d4996206529d5595295f3.r2.cloudflarestorage.com",
    "R2_BUCKET_NAME": "vibe-staging-artist-media",
    "CUOTA_ALMACENAMIENTO_MODO": "rechazar",
    "NEXT_PUBLIC_VALIDACION_BLOQUES": "rechazar"
  }
}
