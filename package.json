{
  "name": "my-project",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=22",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "vitest run --config vitest.db.config.mjs",
    "test:e2e": "playwright test --config playwright.config.ts",
    "test:e2e:auth": "playwright test --config playwright.auth.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "test:visual:auth": "playwright test --config playwright.visual-auth.config.ts",
    "test:visual:auth:update": "playwright test --config playwright.visual-auth.config.ts --update-snapshots",
    "test:visual:update": "playwright test --config playwright.visual.config.ts --update-snapshots",
    "typecheck": "tsc --noEmit",
    "qa": "pnpm typecheck && pnpm lint && pnpm test",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --no-seed",
    "db:lint": "supabase db lint --level warning --fail-on error",
    "db:verify": "node scripts/verify-db.mjs",
    "smoke": "node scripts/smoke-staging.mjs",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@base-ui/react": "^1.7.0",
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@supabase/ssr": "^0.12.5",
    "@supabase/supabase-js": "^2.112.4",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "country-state-city": "^3.2.1",
    "framer-motion": "^12.43.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.39.0",
    "next": "16.3.4",
    "qrcode": "^1.5.4",
    "react": "^19",
    "react-dom": "^19",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "^8.5.26",
    "shadcn": "^4.19.1",
    "supabase": "^2.116.0",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.129.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
