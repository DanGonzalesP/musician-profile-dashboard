# Variables de entorno de Vibe — NOMBRES CANÓNICOS, SIN VALORES.
#
# Copia este archivo a `.env.local` y rellénalo con tus credenciales.
# `.env.local` está en .gitignore y NUNCA debe commitearse.
#
# Columna "fail-closed": qué pasa si la variable falta.

# ─── Supabase ────────────────────────────────────────────────────────────────
# Obligatorias. Sin ellas la app no arranca ni compila el build.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# NO existe ninguna variable de service role, y no debe crearse.
# Toda escritura pasa por RLS con el JWT del usuario. Ver AGENTS.md.

# ─── Cloudflare R2 ───────────────────────────────────────────────────────────
# Obligatorias para subir/borrar archivos. Sin ellas /api/upload-url responde
# 503 con un mensaje seguro en vez de firmar una subida que no puede terminar
# (fail-closed, ver lib/r2-config.ts).
#
# ⚠️ R2_ENDPOINT tiene que existir TAMBIÉN EN EL ENTORNO DE BUILD de Vercel,
# no sólo en el de ejecución. Motivo: de él sale el origen que lib/csp.ts mete
# en `connect-src` para que el navegador pueda hacer el PUT directo a R2, y esa
# CSP se arma en proxy.ts, que es Edge middleware — Next incrusta ahí las
# variables durante el build. Si falta en el build, la política sale sin ese
# origen y el navegador bloquea TODAS las subidas aunque la variable esté
# puesta en runtime. En Vercel: marcarla para Production, Preview y Development.
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# URL pública del bucket (la que sirve las imágenes y el audio al navegador).
# También es el ÚNICO origen que /api/image-proxy acepta.
NEXT_PUBLIC_R2_PUBLIC_URL=

# ─── Sitio ───────────────────────────────────────────────────────────────────
# Dominio canónico. Sin ella, los metadatos Open Graph y el sitemap caen a la
# URL efímera de Vercel o a localhost — las redes sociales rechazan relativas.
NEXT_PUBLIC_SITE_URL=

# ─── Administración ──────────────────────────────────────────────────────────
# UUIDs de Supabase separados por coma. Fail-closed: si falta, NADIE es admin,
# y /api/cleanup-orphaned-files y /admin/* quedan cerrados para todos.
ADMIN_USER_IDS=

# ─── Together AI (generación de imágenes) ────────────────────────────────────
# Fail-closed: si falta, /api/generate-image responde 503 con un mensaje claro
# en vez de llamar al tercero con "Bearer undefined".
TOGETHER_API_KEY=

# ─── Meta oEmbed (Facebook / Instagram) ──────────────────────────────────────
# Opcional. Sin ella, los embeds de Meta caen al modo sin token.
META_APP_ACCESS_TOKEN=

# ─── Proxy de confianza (rate limit por IP) ──────────────────────────────────
# En Vercel se detecta solo (process.env.VERCEL === "1"). Fuera de Vercel,
# poner TRUSTED_PROXY=true SOLO si un proxy inverso propio reescribe
# x-forwarded-for. Si no, la cabecera es falsificable y el límite por IP se
# evade con un header. Fail-closed: por defecto NO se confía.
TRUSTED_PROXY=

# ─── Validación de bloques (F3) ──────────────────────────────────────────────
# Ausente u "observar": el validador REGISTRA lo que habría rechazado y deja
# publicar (valor por defecto, seguro). "rechazar": activa el rechazo en el
# editor. Se pasa a "rechazar" recién después de revisar los registros de
# observación contra los perfiles reales. Ver lib/blocks-schema.ts.
NEXT_PUBLIC_VALIDACION_BLOQUES=

# ─── Pruebas de base de datos (F7) ───────────────────────────────────────────
# Apuntan al Supabase LOCAL de `pnpm db:start`. Nunca a producción.
SUPABASE_TEST_URL=
SUPABASE_TEST_ANON_KEY=
# Solo para crear/borrar usuarios efímeros del arnés de pruebas, en local.
# JAMÁS se define en Vercel ni se usa desde código de la aplicación.
SUPABASE_TEST_SERVICE_ROLE_KEY=
