{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Plantilla: los nombres propuestos NO acreditan recursos creados.
  // Copiar a wrangler.staging.jsonc en una copia aislada de preparación.
  "name": "vibe-staging",
  "account_id": "5b647e532f3d4996206529d5595295f3",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  // No añadir ruta pública hasta definir acceso y origen de staging.
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "vibe-staging" }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": ["/ffmpeg/ffmpeg-core.wasm"]
  },
  "observability": { "enabled": true },
  "r2_buckets": [
    { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "vibe-staging-cache-incremental" },
    { "binding": "VIBE_STATIC_ASSETS", "bucket_name": "vibe-staging-static-assets" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "d1_databases": [{
    "binding": "NEXT_TAG_CACHE_D1",
    "database_name": "vibe-staging-cache-etiquetas",
    "database_id": "REEMPLAZAR_POR_UUID_D1_EXCLUSIVA_DE_STAGING"
  }],
  "vars": { "TRUSTED_PROXY": "true" }
}
